# ==============================================================================
# Archivo de Ejemplo de Variables de Entorno (.env.example)
# Copia este archivo a '.env' para configurar tu entorno local.
# IMPORTANTE: El archivo '.env' real contiene contraseñas y NUNCA debe subirse a Git.
# ==============================================================================

# Nombre del servicio del Contenedor 2 dentro de la red Docker
DB_HOST=db
DB_PORT=5432
DB_EXTERNAL_PORT=5432

# Credenciales de Base de Datos PostgreSQL
DB_NAME=proyectodb
DB_USER=postgres_user
DB_PASSWORD=secret_postgres_password_change_me

# Configuración del Contenedor 1 (Aplicación Web)
APP_PORT=5000
FLASK_ENV=production
